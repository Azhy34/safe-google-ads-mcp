# =====================================================================
# Safe Google Ads FastMCP Server - environment configuration
# Copy the variables into your .env (core/config.py loads it). Never commit real values.
# =====================================================================

# --- 1. Google Ads API (OAuth2) ---
# Developer token of your manager (MCC) account
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth2 client of your Google Cloud project and the refresh token generated for your Google Ads user
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Manager (MCC) account the calls go through, 10 digits without dashes (policy account.login_customer_id is the fallback)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Account to operate on, 10 digits without dashes (policy account.customer_id wins when it is set)
GOOGLE_ADS_CUSTOMER_ID=

# --- 2. Business policy (identity and rules of YOUR advertiser; see docs/POLICY.md) ---
# Optional path of a policy file. Without it: config/policy.local.json (private, ignored by git), then config/policy.json (neutral).
MCP_POLICY_FILE=

# --- 3. Online journal: Cloud Logging + Cloud Trace (optional, see skills/google-ads-mcp-manager/references/dual-logging-and-trace.md) ---
# Without these two the server logs only to logs/audit.jsonl
GOOGLE_CLOUD_PROJECT=
# Key of a write-only service account (Logs Writer + Cloud Trace Agent), stored outside the repository
MCP_CLOUD_LOG_CREDENTIALS=
# Your name in the journal: every operator runs their own clone and the owner sees all of them
MCP_OPERATOR=local_operator
# Read-only key (Logs Viewer + Cloud Trace User) for get_cloud_logs / get_cloud_trace / analyze_tool_health
MCP_CLOUD_LOG_READER_CREDENTIALS=

# --- 4. Preflight gate ---
# 1 = ad tools refuse to run until preflight_log_check has passed (default), 0 = disabled for development
MCP_PREFLIGHT_REQUIRED=1
